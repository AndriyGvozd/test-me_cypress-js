{
  "name": "test-me-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "UI and API automated tests for https://test-me.vzl.one (Cypress + JS)",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:parallel": "node scripts/run-parallel.mjs",
    "test:api": "cypress run --config-file cypress.api.config.js",
    "test:ui": "cypress run --spec 'cypress/e2e/ui/**/*.cy.js'",
    "test:a11y": "cypress run --spec cypress/e2e/ui/accessibility.cy.js",
    "test:network": "cypress run --spec cypress/e2e/ui/network-errors.cy.js",
    "test:mobile": "cypress run --spec cypress/e2e/ui/mobile.cy.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "cypress": "^16.2.0",
    "cypress-real-events": "^1.15.1",
    "eslint": "^10.13.0",
    "eslint-plugin-cypress": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
